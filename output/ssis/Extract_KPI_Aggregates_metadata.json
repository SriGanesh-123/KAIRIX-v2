  "components": [
    {
      "component_id": 1,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "SRC - stg.premium (pre-aggregated by policy_period)",
      "component_type": "Microsoft.OLEDBSource",
      "description": "Reads the premium summary produced by Extract_Premium's Aggregate transform.",
      "properties": {
        "OpenRowset": "stg.premium_summary_by_period",
        "ConnectionManager": "CM_DW_PG_Target"
      }
    },
    {
      "component_id": 2,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "SRC - stg.claims (pre-aggregated by policy, BR-09)",
      "component_type": "Microsoft.OLEDBSource",
      "description": "Reads the claims incurred summary produced by Extract_Claims's Aggregate transform.",
      "properties": {
        "OpenRowset": "stg.claims_incurred_summary_by_policy",
        "ConnectionManager": "CM_DW_PG_Target"
      }
    },
    {
      "component_id": 3,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "SRC - stg.policy_period",
      "component_type": "Microsoft.OLEDBSource",
      "description": "Reads policy_period_id to policy_id mapping needed to join premium (by period) with claims (by policy).",
      "properties": {
        "OpenRowset": "stg.policy_period",
        "ConnectionManager": "CM_DW_PG_Target"
      }
    },
    {
      "component_id": 4,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "SRC - stg.job (for retention rate)",
      "component_type": "Microsoft.OLEDBSource",
      "description": "Reads job_type / job_status to classify RENEWAL vs original/expiring policies for Retention Rate KPI.",
      "properties": {
        "OpenRowset": "stg.job",
        "ConnectionManager": "CM_DW_PG_Target"
      }
    },
    {
      "component_id": 5,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "SORT - Premium by policy_period_id",
      "component_type": "Microsoft.Sort",
      "description": "Sorts premium summary for the downstream Merge Join (Merge Join requires sorted inputs).",
      "properties": {
        "SortKey": "policy_period_id ASC"
      }
    },
    {
      "component_id": 6,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "SORT - PolicyPeriod by policy_period_id",
      "component_type": "Microsoft.Sort",
      "description": "Sorts policy_period for the Merge Join.",
      "properties": {
        "SortKey": "policy_period_id ASC"
      }
    },
    {
      "component_id": 7,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "MRG - Join Premium to PolicyPeriod (get policy_id)",
      "component_type": "Microsoft.MergeJoin",
      "description": "INNER JOIN on policy_period_id to resolve policy_id for each premium summary row.",
      "properties": {
        "JoinType": "Inner",
        "JoinKey": "policy_period_id"
      }
    },
    {
      "component_id": 8,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "SORT - Premium+PolicyID by policy_id",
      "component_type": "Microsoft.Sort",
      "description": "Re-sorts by policy_id ahead of the second Merge Join against claims.",
      "properties": {
        "SortKey": "policy_id ASC"
      }
    },
    {
      "component_id": 9,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "SORT - Claims by policy_id",
      "component_type": "Microsoft.Sort",
      "description": "Sorts the pre-aggregated claims summary for the Merge Join.",
      "properties": {
        "SortKey": "policy_id ASC"
      }
    },
    {
      "component_id": 10,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "MRG - Merge Join Premium to Claims (LEFT OUTER, by policy_id)",
      "component_type": "Microsoft.MergeJoin",
      "description": "LEFT OUTER JOIN so policies with zero claims still produce a KPI row (incurred defaults to 0).",
      "properties": {
        "JoinType": "LeftOuter",
        "JoinKey": "policy_id"
      }
    },
    {
      "component_id": 11,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "DER - KPI Calculations (BR-10 / BR-11)",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Computes Loss Ratio, Commission Ratio and Underwriting Profit with divide-by-zero protection.",
      "properties": {
        "Expressions": "ISNULL(incurred_amount,0) -> incurred_amount_safe; (earned_premium == 0) ? 0.0 : (incurred_amount_safe / earned_premium * 100.0) -> loss_ratio (BR-10); (written_premium == 0) ? 0.0 : (commission_amount / written_premium * 100.0) -> commission_ratio; earned_premium - incurred_amount_safe - commission_amount - operating_expense -> underwriting_profit (BR-11); GETDATE() -> etl_load_date"
      }
    },
    {
      "component_id": 12,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "AGG - Retention Rate Inputs (renewed vs expiring policy counts)",
      "component_type": "Microsoft.Aggregation",
      "description": "Counts RENEWAL jobs vs total policies reaching expiration, grouped by month, to feed Retention Rate = Renewed / Expiring * 100.",
      "properties": {
        "GroupBy": "DATEPART(yyyy,job_date), DATEPART(mm,job_date)",
        "Aggregates": "COUNT(CASE WHEN job_type='Renewal' THEN 1 END) AS renewed_count, COUNT(CASE WHEN job_type IN ('New Business','Renewal') THEN 1 END) AS expiring_count"
      }
    },
    {
      "component_id": 13,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "DER - Retention Rate (%)",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Retention Rate = Renewed Policies / Expiring Policies * 100, divide-by-zero protected.",
      "properties": {
        "Expressions": "(expiring_count == 0) ? 0.0 : (renewed_count * 1.0 / expiring_count * 100.0) -> retention_rate"
      }
    },
    {
      "component_id": 14,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "DST - Load fact_kpi_summary (per policy)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Loads Loss Ratio / Commission Ratio / Underwriting Profit rows into rpt.fact_kpi_summary.",
      "properties": {
        "OpenRowset": "rpt.fact_kpi_summary",
        "ConnectionManager": "CM_DW_PG_Target",
        "FastLoad": "true"
      }
    },
    {
      "component_id": 15,
      "package_name": "Extract_KPI_Aggregates",
      "task_name": "DFT - Merge, Aggregate, Calculate KPIs",
      "component_name": "DST - Load fact_retention_rate (monthly)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Loads monthly Retention Rate KPI into rpt.fact_retention_rate.",
      "properties": {
        "OpenRowset": "rpt.fact_retention_rate",
        "ConnectionManager": "CM_DW_PG_Target",
        "FastLoad": "true"
      }
    }
  ],
