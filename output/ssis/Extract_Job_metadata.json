  "components": [
    {
      "component_id": 1,
      "package_name": "Extract_Job",
      "task_name": "DFT - Extract, Cleanse, Validate, Load job",
      "component_name": "SRC - job (PostgreSQL)",
      "component_type": "Microsoft.ADO.NET.PGSource",
      "description": "Extracts rows from public.job on CM_Guidewire_PG_Source",
      "properties": {
        "SqlCommand": "SELECT job_id, policy_id, job_type, job_date, created_ts, job_number, job_status, submission_date, effective_date, expiration_date FROM public.job",
        "ConnectionManager": "CM_Guidewire_PG_Source"
      }
    },
    {
      "component_id": 2,
      "package_name": "Extract_Job",
      "task_name": "DFT - Extract, Cleanse, Validate, Load job",
      "component_name": "LKP - Validate Policy (policy_id)",
      "component_type": "Microsoft.Lookup",
      "description": "Validates policy_id exists in Policy (referential integrity / BR-01, BR-05)",
      "properties": {
        "SqlCommandParam": "SELECT policy_id FROM stg.policy",
        "JoinColumn": "policy_id",
        "NoMatchBehavior": "RedirectRowsToNoMatchOutput",
        "CacheMode": "Full"
      }
    },
    {
      "component_id": 3,
      "package_name": "Extract_Job",
      "task_name": "DFT - Extract, Cleanse, Validate, Load job",
      "component_name": "DER - Data Cleansing",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Trims whitespace, standardizes casing/codes, normalizes nulls",
      "properties": {
        "Expressions": "TRIM(job_number) -> job_number"
      }
    },
    {
      "component_id": 4,
      "package_name": "Extract_Job",
      "task_name": "DFT - Extract, Cleanse, Validate, Load job",
      "component_name": "DER - Derived / Calculated Columns",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Adds ETL metadata columns and business-calculated fields",
      "properties": {
        "Expressions": "GETDATE() -> etl_load_date; job_type == 'New Business' ? 1 : 0 -> is_new_business_flag"
      }
    },
    {
      "component_id": 5,
      "package_name": "Extract_Job",
      "task_name": "DFT - Extract, Cleanse, Validate, Load job",
      "component_name": "CSPL - Business Rule Validation",
      "component_type": "Microsoft.ConditionalSplit",
      "description": "Routes rows failing business rules to error output. Rules: job_date <= GETDATE() | (expiration_date IS NULL) OR (effective_date IS NULL) OR (expiration_date > effective_date) | job_status IN ('PENDING','IN_PROGRESS','COMPLETED','CANCELLED')",
      "properties": {
        "ValidOutputName": "Valid Rows",
        "InvalidOutputName": "Invalid Rows (-> Error Path)",
        "Conditions": "job_date <= GETDATE() | (expiration_date IS NULL) OR (effective_date IS NULL) OR (expiration_date > effective_date) | job_status IN ('PENDING','IN_PROGRESS','COMPLETED','CANCELLED')"
      }
    },
    {
      "component_id": 6,
      "package_name": "Extract_Job",
      "task_name": "DFT - Extract, Cleanse, Validate, Load job",
      "component_name": "UN - Union All Error Rows",
      "component_type": "Microsoft.UnionAll",
      "description": "Combines all error/no-match/invalid outputs into a single error stream",
      "properties": {}
    },
    {
      "component_id": 7,
      "package_name": "Extract_Job",
      "task_name": "DFT - Extract, Cleanse, Validate, Load job",
      "component_name": "DST - Error Log (stg.error_quarantine)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Writes rejected/invalid rows to the error-quarantine table for review",
      "properties": {
        "OpenRowset": "stg.error_quarantine",
        "ConnectionManager": "CM_DW_PG_Target"
      }
    },
    {
      "component_id": 8,
      "package_name": "Extract_Job",
      "task_name": "DFT - Extract, Cleanse, Validate, Load job",
      "component_name": "DST - Load job (PostgreSQL DW)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Loads validated/cleansed rows into stg.job (upsert via staging + MERGE in post-SQL)",
      "properties": {
        "OpenRowset": "stg.job",
        "ConnectionManager": "CM_DW_PG_Target",
        "FastLoad": "true",
        "MaximumInsertCommitSize": "10000"
      }
    }
  ],
