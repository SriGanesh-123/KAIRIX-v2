  "components": [
    {
      "component_id": 1,
      "package_name": "Extract_Account",
      "task_name": "DFT - Extract, Cleanse, Validate, Load account",
      "component_name": "SRC - account (PostgreSQL)",
      "component_type": "Microsoft.ADO.NET.PGSource",
      "description": "Extracts rows from public.account on CM_Guidewire_PG_Source",
      "properties": {
        "SqlCommand": "SELECT account_id, account_number, account_name, industry_type, state_code, account_status, created_date, updated_timestamp FROM public.account",
        "ConnectionManager": "CM_Guidewire_PG_Source"
      }
    },
    {
      "component_id": 2,
      "package_name": "Extract_Account",
      "task_name": "DFT - Extract, Cleanse, Validate, Load account",
      "component_name": "DER - Data Cleansing",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Trims whitespace, standardizes casing/codes, normalizes nulls",
      "properties": {
        "Expressions": "TRIM(account_name) -> account_name; UPPER(TRIM(state_code)) -> state_code"
      }
    },
    {
      "component_id": 3,
      "package_name": "Extract_Account",
      "task_name": "DFT - Extract, Cleanse, Validate, Load account",
      "component_name": "DER - Derived / Calculated Columns",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Adds ETL metadata columns and business-calculated fields",
      "properties": {
        "Expressions": "GETDATE() -> etl_load_date; 'Guidewire PolicyCenter' -> etl_source_system"
      }
    },
    {
      "component_id": 4,
      "package_name": "Extract_Account",
      "task_name": "DFT - Extract, Cleanse, Validate, Load account",
      "component_name": "CSPL - Business Rule Validation",
      "component_type": "Microsoft.ConditionalSplit",
      "description": "Routes rows failing business rules to error output. Rules: created_date <= GETDATE() (BR: cannot be future-dated) | account_status IN ('ACTIVE','INACTIVE','CLOSED') | account_number LIKE 'ACC%%' AND LEN(account_number)=9",
      "properties": {
        "ValidOutputName": "Valid Rows",
        "InvalidOutputName": "Invalid Rows (-> Error Path)",
        "Conditions": "created_date <= GETDATE() (BR: cannot be future-dated) | account_status IN ('ACTIVE','INACTIVE','CLOSED') | account_number LIKE 'ACC%%' AND LEN(account_number)=9"
      }
    },
    {
      "component_id": 5,
      "package_name": "Extract_Account",
      "task_name": "DFT - Extract, Cleanse, Validate, Load account",
      "component_name": "UN - Union All Error Rows",
      "component_type": "Microsoft.UnionAll",
      "description": "Combines all error/no-match/invalid outputs into a single error stream",
      "properties": {}
    },
    {
      "component_id": 6,
      "package_name": "Extract_Account",
      "task_name": "DFT - Extract, Cleanse, Validate, Load account",
      "component_name": "DST - Error Log (stg.error_quarantine)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Writes rejected/invalid rows to the error-quarantine table for review",
      "properties": {
        "OpenRowset": "stg.error_quarantine",
        "ConnectionManager": "CM_DW_PG_Target"
      }
    },
    {
      "component_id": 7,
      "package_name": "Extract_Account",
      "task_name": "DFT - Extract, Cleanse, Validate, Load account",
      "component_name": "DST - Load account (PostgreSQL DW)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Loads validated/cleansed rows into stg.account (upsert via staging + MERGE in post-SQL)",
      "properties": {
        "OpenRowset": "stg.account",
        "ConnectionManager": "CM_DW_PG_Target",
        "FastLoad": "true",
        "MaximumInsertCommitSize": "10000"
      }
    }
