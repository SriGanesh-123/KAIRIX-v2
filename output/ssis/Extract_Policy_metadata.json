    {
      "component_id": 1,
      "package_name": "Extract_Policy",
      "task_name": "DFT - Extract, Cleanse, Validate, Load policy",
      "component_name": "SRC - policy (PostgreSQL)",
      "component_type": "Microsoft.ADO.NET.PGSource",
      "description": "Extracts rows from public.policy on CM_Guidewire_PG_Source",
      "properties": {
        "SqlCommand": "SELECT policy_id, account_id, producer_id, policy_number, product_code, policy_status, effective_date, expiration_date, cancellation_date, cancellation_reason, updated_timestamp FROM public.policy",
        "ConnectionManager": "CM_Guidewire_PG_Source"
      }
    },
    {
      "component_id": 2,
      "package_name": "Extract_Policy",
      "task_name": "DFT - Extract, Cleanse, Validate, Load policy",
      "component_name": "LKP - Validate Account (account_id)",
      "component_type": "Microsoft.Lookup",
      "description": "Validates account_id exists in Account (referential integrity / BR-01, BR-05)",
      "properties": {
        "SqlCommandParam": "SELECT account_id FROM stg.account",
        "JoinColumn": "account_id",
        "NoMatchBehavior": "RedirectRowsToNoMatchOutput",
        "CacheMode": "Full"
      }
    },
    {
      "component_id": 3,
      "package_name": "Extract_Policy",
      "task_name": "DFT - Extract, Cleanse, Validate, Load policy",
      "component_name": "LKP - Validate Producer (producer_id)",
      "component_type": "Microsoft.Lookup",
      "description": "Validates producer_id exists in Producer (referential integrity / BR-01, BR-05)",
      "properties": {
        "SqlCommandParam": "SELECT producer_id FROM stg.producer",
        "JoinColumn": "producer_id",
        "NoMatchBehavior": "RedirectRowsToNoMatchOutput",
        "CacheMode": "Full"
      }
    },
    {
      "component_id": 4,
      "package_name": "Extract_Policy",
      "task_name": "DFT - Extract, Cleanse, Validate, Load policy",
      "component_name": "DER - Data Cleansing",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Trims whitespace, standardizes casing/codes, normalizes nulls",
      "properties": {
        "Expressions": "TRIM(policy_number) -> policy_number; UPPER(product_code) -> product_code"
      }
    },
    {
      "component_id": 5,
      "package_name": "Extract_Policy",
      "task_name": "DFT - Extract, Cleanse, Validate, Load policy",
      "component_name": "DER - Derived / Calculated Columns",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Adds ETL metadata columns and business-calculated fields",
      "properties": {
        "Expressions": "GETDATE() -> etl_load_date"
      }
    },
    {
      "component_id": 6,
      "package_name": "Extract_Policy",
      "task_name": "DFT - Extract, Cleanse, Validate, Load policy",
      "component_name": "CSPL - Business Rule Validation",
      "component_type": "Microsoft.ConditionalSplit",
      "description": "Routes rows failing business rules to error output. Rules: expiration_date > effective_date | policy_status IN ('ACTIVE','INACTIVE','LAPSED','CANCELLED') | (cancellation_date IS NULL) OR (cancellation_date > effective_date AND cancellation_date < expiration_date)",
      "properties": {
        "ValidOutputName": "Valid Rows",
        "InvalidOutputName": "Invalid Rows (-> Error Path)",
        "Conditions": "expiration_date > effective_date | policy_status IN ('ACTIVE','INACTIVE','LAPSED','CANCELLED') | (cancellation_date IS NULL) OR (cancellation_date > effective_date AND cancellation_date < expiration_date)"
      }
    },
    {
      "component_id": 7,
      "package_name": "Extract_Policy",
      "task_name": "DFT - Extract, Cleanse, Validate, Load policy",
      "component_name": "UN - Union All Error Rows",
      "component_type": "Microsoft.UnionAll",
      "description": "Combines all error/no-match/invalid outputs into a single error stream",
      "properties": {}
    },
    {
      "component_id": 8,
      "package_name": "Extract_Policy",
      "task_name": "DFT - Extract, Cleanse, Validate, Load policy",
      "component_name": "DST - Error Log (stg.error_quarantine)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Writes rejected/invalid rows to the error-quarantine table for review",
      "properties": {
        "OpenRowset": "stg.error_quarantine",
        "ConnectionManager": "CM_DW_PG_Target"
      }
    },
    {
      "component_id": 9,
      "package_name": "Extract_Policy",
      "task_name": "DFT - Extract, Cleanse, Validate, Load policy",
      "component_name": "DST - Load policy (PostgreSQL DW)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Loads validated/cleansed rows into stg.policy (upsert via staging + MERGE in post-SQL)",
      "properties": {
        "OpenRowset": "stg.policy",
        "ConnectionManager": "CM_DW_PG_Target",
        "FastLoad": "true",
        "MaximumInsertCommitSize": "10000"
      }
    }
  ],
