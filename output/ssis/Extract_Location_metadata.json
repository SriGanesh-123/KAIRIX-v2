  "components": [
    {
      "component_id": 1,
      "package_name": "Extract_Location",
      "task_name": "DFT - Extract, Cleanse, Validate, Load location",
      "component_name": "SRC - location (PostgreSQL)",
      "component_type": "Microsoft.ADO.NET.PGSource",
      "description": "Extracts rows from public.location on CM_Guidewire_PG_Source",
      "properties": {
        "SqlCommand": "SELECT location_id, policy_period_id, location_number, address_line1, address_line2, city, state_code, zip_code, country_code, occupancy_type, building_value, contents_value FROM public.location",
        "ConnectionManager": "CM_Guidewire_PG_Source"
      }
    },
    {
      "component_id": 2,
      "package_name": "Extract_Location",
      "task_name": "DFT - Extract, Cleanse, Validate, Load location",
      "component_name": "LKP - Validate Policy_Period (policy_period_id)",
      "component_type": "Microsoft.Lookup",
      "description": "Validates policy_period_id exists in Policy_Period (referential integrity / BR-01, BR-05)",
      "properties": {
        "SqlCommandParam": "SELECT policy_period_id FROM stg.policy_period",
        "JoinColumn": "policy_period_id",
        "NoMatchBehavior": "RedirectRowsToNoMatchOutput",
        "CacheMode": "Full"
      }
    },
    {
      "component_id": 3,
      "package_name": "Extract_Location",
      "task_name": "DFT - Extract, Cleanse, Validate, Load location",
      "component_name": "DER - Data Cleansing",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Trims whitespace, standardizes casing/codes, normalizes nulls",
      "properties": {
        "Expressions": "TRIM(address_line1) -> address_line1; TRIM(city) -> city; UPPER(TRIM(state_code)) -> state_code; UPPER(TRIM(country_code)) -> country_code; ISNULL(address_line2,'') -> address_line2"
      }
    },
    {
      "component_id": 4,
      "package_name": "Extract_Location",
      "task_name": "DFT - Extract, Cleanse, Validate, Load location",
      "component_name": "DER - Derived / Calculated Columns",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Adds ETL metadata columns and business-calculated fields",
      "properties": {
        "Expressions": "GETDATE() -> etl_load_date"
      }
    },
    {
      "component_id": 5,
      "package_name": "Extract_Location",
      "task_name": "DFT - Extract, Cleanse, Validate, Load location",
      "component_name": "CSPL - Business Rule Validation",
      "component_type": "Microsoft.ConditionalSplit",
      "description": "Routes rows failing business rules to error output. Rules: building_value >= 0.00 | contents_value >= 0.00 | occupancy_type IN ('OWNER_OCCUPIED','TENANT_OCCUPIED','VACANT','UNDER_CONSTRUCTION','OTHER')",
      "properties": {
        "ValidOutputName": "Valid Rows",
        "InvalidOutputName": "Invalid Rows (-> Error Path)",
        "Conditions": "building_value >= 0.00 | contents_value >= 0.00 | occupancy_type IN ('OWNER_OCCUPIED','TENANT_OCCUPIED','VACANT','UNDER_CONSTRUCTION','OTHER')"
      }
    },
    {
      "component_id": 6,
      "package_name": "Extract_Location",
      "task_name": "DFT - Extract, Cleanse, Validate, Load location",
      "component_name": "UN - Union All Error Rows",
      "component_type": "Microsoft.UnionAll",
      "description": "Combines all error/no-match/invalid outputs into a single error stream",
      "properties": {}
    },
    {
      "component_id": 7,
      "package_name": "Extract_Location",
      "task_name": "DFT - Extract, Cleanse, Validate, Load location",
      "component_name": "DST - Error Log (stg.error_quarantine)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Writes rejected/invalid rows to the error-quarantine table for review",
      "properties": {
        "OpenRowset": "stg.error_quarantine",
        "ConnectionManager": "CM_DW_PG_Target"
      }
    },
    {
      "component_id": 8,
      "package_name": "Extract_Location",
      "task_name": "DFT - Extract, Cleanse, Validate, Load location",
      "component_name": "DST - Load location (PostgreSQL DW)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Loads validated/cleansed rows into stg.location (upsert via staging + MERGE in post-SQL)",
      "properties": {
        "OpenRowset": "stg.location",
        "ConnectionManager": "CM_DW_PG_Target",
        "FastLoad": "true",
        "MaximumInsertCommitSize": "10000"
      }
    }
  ],
