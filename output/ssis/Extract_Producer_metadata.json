  "components": [
    {
      "component_id": 1,
      "package_name": "Extract_Producer",
      "task_name": "DFT - Extract, Cleanse, Validate, Load producer",
      "component_name": "SRC - producer (PostgreSQL)",
      "component_type": "Microsoft.ADO.NET.PGSource",
      "description": "Extracts rows from public.producer on CM_Guidewire_PG_Source",
      "properties": {
        "SqlCommand": "SELECT producer_id, producer_code, producer_name, commission_rate, producer_type, state_code, producer_status, created_date FROM public.producer",
        "ConnectionManager": "CM_Guidewire_PG_Source"
      }
    },
    {
      "component_id": 2,
      "package_name": "Extract_Producer",
      "task_name": "DFT - Extract, Cleanse, Validate, Load producer",
      "component_name": "DER - Data Cleansing",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Trims whitespace, standardizes casing/codes, normalizes nulls",
      "properties": {
        "Expressions": "TRIM(producer_name) -> producer_name; UPPER(TRIM(state_code)) -> state_code"
      }
    },
    {
      "component_id": 3,
      "package_name": "Extract_Producer",
      "task_name": "DFT - Extract, Cleanse, Validate, Load producer",
      "component_name": "DER - Derived / Calculated Columns",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Adds ETL metadata columns and business-calculated fields",
      "properties": {
        "Expressions": "GETDATE() -> etl_load_date"
      }
    },
    {
      "component_id": 4,
      "package_name": "Extract_Producer",
      "task_name": "DFT - Extract, Cleanse, Validate, Load producer",
      "component_name": "CSPL - Business Rule Validation",
      "component_type": "Microsoft.ConditionalSplit",
      "description": "Routes rows failing business rules to error output. Rules: commission_rate >= 0.00 AND commission_rate <= 100.00 | producer_type IN ('AGENCY','BROKER','AGENT','INDIVIDUAL') | created_date <= GETDATE()",
      "properties": {
        "ValidOutputName": "Valid Rows",
        "InvalidOutputName": "Invalid Rows (-> Error Path)",
        "Conditions": "commission_rate >= 0.00 AND commission_rate <= 100.00 | producer_type IN ('AGENCY','BROKER','AGENT','INDIVIDUAL') | created_date <= GETDATE()"
      }
    },
    {
      "component_id": 5,
      "package_name": "Extract_Producer",
      "task_name": "DFT - Extract, Cleanse, Validate, Load producer",
      "component_name": "UN - Union All Error Rows",
      "component_type": "Microsoft.UnionAll",
      "description": "Combines all error/no-match/invalid outputs into a single error stream",
      "properties": {}
    },
    {
      "component_id": 6,
      "package_name": "Extract_Producer",
      "task_name": "DFT - Extract, Cleanse, Validate, Load producer",
      "component_name": "DST - Error Log (stg.error_quarantine)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Writes rejected/invalid rows to the error-quarantine table for review",
      "properties": {
        "OpenRowset": "stg.error_quarantine",
        "ConnectionManager": "CM_DW_PG_Target"
      }
    },
    {
      "component_id": 7,
      "package_name": "Extract_Producer",
      "task_name": "DFT - Extract, Cleanse, Validate, Load producer",
      "component_name": "DST - Load producer (PostgreSQL DW)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Loads validated/cleansed rows into stg.producer (upsert via staging + MERGE in post-SQL)",
      "properties": {
        "OpenRowset": "stg.producer",
        "ConnectionManager": "CM_DW_PG_Target",
        "FastLoad": "true",
        "MaximumInsertCommitSize": "10000"
      }
    }
  ],
