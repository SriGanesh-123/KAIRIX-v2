  "components": [
    {
      "component_id": 1,
      "package_name": "Extract_Premium",
      "task_name": "DFT - Extract, Cleanse, Validate, Load premium",
      "component_name": "SRC - premium (PostgreSQL)",
      "component_type": "Microsoft.ADO.NET.PGSource",
      "description": "Extracts rows from public.premium on CM_Guidewire_PG_Source",
      "properties": {
        "SqlCommand": "SELECT premium_id, policy_period_id, written_premium, earned_premium, unearned_premium, transaction_date, currency_code, commission_rate, commission_amount, operating_expense, as_of_date FROM public.premium",
        "ConnectionManager": "CM_Guidewire_PG_Source"
      }
    },
    {
      "component_id": 2,
      "package_name": "Extract_Premium",
      "task_name": "DFT - Extract, Cleanse, Validate, Load premium",
      "component_name": "LKP - Validate Policy_Period (policy_period_id)",
      "component_type": "Microsoft.Lookup",
      "description": "Validates policy_period_id exists in Policy_Period (referential integrity / BR-01, BR-05)",
      "properties": {
        "SqlCommandParam": "SELECT policy_period_id FROM stg.policy_period",
        "JoinColumn": "policy_period_id",
        "NoMatchBehavior": "RedirectRowsToNoMatchOutput",
        "CacheMode": "Full"
      }
    },
    {
      "component_id": 3,
      "package_name": "Extract_Premium",
      "task_name": "DFT - Extract, Cleanse, Validate, Load premium",
      "component_name": "DER - Data Cleansing",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Trims whitespace, standardizes casing/codes, normalizes nulls",
      "properties": {
        "Expressions": "UPPER(TRIM(currency_code)) -> currency_code"
      }
    },
    {
      "component_id": 4,
      "package_name": "Extract_Premium",
      "task_name": "DFT - Extract, Cleanse, Validate, Load premium",
      "component_name": "DER - Derived / Calculated Columns",
      "component_type": "Microsoft.DerivedColumn",
      "description": "Adds ETL metadata columns and business-calculated fields",
      "properties": {
        "Expressions": "GETDATE() -> etl_load_date; commission_rate * written_premium / 100 -> expected_commission_amount"
      }
    },
    {
      "component_id": 5,
      "package_name": "Extract_Premium",
      "task_name": "DFT - Extract, Cleanse, Validate, Load premium",
      "component_name": "CSPL - Business Rule Validation",
      "component_type": "Microsoft.ConditionalSplit",
      "description": "Routes rows failing business rules to error output. Rules: earned_premium <= written_premium (BR-07) | ABS(written_premium - (earned_premium + unearned_premium)) <= 1.00 (BR-08 rounding tolerance) | written_premium >= 0.00 AND commission_rate BETWEEN 0.00 AND 100.00 | transaction_date <= GETDATE() AND as_of_date <= GETDATE()",
      "properties": {
        "ValidOutputName": "Valid Rows",
        "InvalidOutputName": "Invalid Rows (-> Error Path)",
        "Conditions": "earned_premium <= written_premium (BR-07) | ABS(written_premium - (earned_premium + unearned_premium)) <= 1.00 (BR-08 rounding tolerance) | written_premium >= 0.00 AND commission_rate BETWEEN 0.00 AND 100.00 | transaction_date <= GETDATE() AND as_of_date <= GETDATE()"
      }
    },
    {
      "component_id": 6,
      "package_name": "Extract_Premium",
      "task_name": "DFT - Extract, Cleanse, Validate, Load premium",
      "component_name": "AGG - Premium Summary by Policy Period",
      "component_type": "Microsoft.Aggregation",
      "description": "Pre-aggregates written/earned/unearned premium per policy_period_id for KPI/reporting reuse (feeds fact_kpi_summary).",
      "properties": {
        "GroupBy": "policy_period_id",
        "Aggregates": "SUM(written_premium), SUM(earned_premium), SUM(unearned_premium), SUM(commission_amount), SUM(operating_expense)"
      }
    },
    {
      "component_id": 7,
      "package_name": "Extract_Premium",
      "task_name": "DFT - Extract, Cleanse, Validate, Load premium",
      "component_name": "UN - Union All Error Rows",
      "component_type": "Microsoft.UnionAll",
      "description": "Combines all error/no-match/invalid outputs into a single error stream",
      "properties": {}
    },
    {
      "component_id": 8,
      "package_name": "Extract_Premium",
      "task_name": "DFT - Extract, Cleanse, Validate, Load premium",
      "component_name": "DST - Error Log (stg.error_quarantine)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Writes rejected/invalid rows to the error-quarantine table for review",
      "properties": {
        "OpenRowset": "stg.error_quarantine",
        "ConnectionManager": "CM_DW_PG_Target"
      }
    },
    {
      "component_id": 9,
      "package_name": "Extract_Premium",
      "task_name": "DFT - Extract, Cleanse, Validate, Load premium",
      "component_name": "DST - Load premium (PostgreSQL DW)",
      "component_type": "Microsoft.OLEDBDestination",
      "description": "Loads validated/cleansed rows into stg.premium (upsert via staging + MERGE in post-SQL)",
      "properties": {
        "OpenRowset": "stg.premium",
        "ConnectionManager": "CM_DW_PG_Target",
        "FastLoad": "true",
        "MaximumInsertCommitSize": "10000"
      }
    }
  ],
