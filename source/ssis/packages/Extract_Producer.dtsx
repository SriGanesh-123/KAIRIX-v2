<?xml version="1.0"?>
<DTS:Executable
    xmlns:DTS="www.microsoft.com/SqlServer/Dts"
    xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
    DTS:ExecutableType="Microsoft.Package"
    DTS:CreationName="Microsoft.Package"
    DTS:DTSID="{FB06FD3F-08D7-4203-8BF6-2AB45647B614}"
    DTS:ObjectName="Extract_Producer"
    DTS:PackageType="5"
    DTS:VersionMajor="1" DTS:VersionMinor="0" DTS:VersionBuild="1"
    DTS:VersionGUID="{09CE8587-8484-4694-A1B2-644B25998736}"
    DTS:Description="Extracts, cleanses, validates and loads PRODUCER master data."
    DTS:LoggingMode="UseParentSetting">
  <DTS:Variables>
    <DTS:Variable DTS:Name="RowsRead"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable>
    <DTS:Variable DTS:Name="RowsInserted"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable>
    <DTS:Variable DTS:Name="RowsRejected"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable>
    <DTS:Variable DTS:Name="PackageName"><DTS:VariableValue DTS:DataType="8">Extract_Producer</DTS:VariableValue></DTS:Variable>
    <DTS:Variable DTS:Name="StartTime"><DTS:VariableValue DTS:DataType="7">1900-01-01T00:00:00</DTS:VariableValue></DTS:Variable>
  </DTS:Variables>
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[CM_Guidewire_PG_Source]"
        DTS:CreationName="ADO.NET:Npgsql"
        DTS:DTSID="{9115364D-372C-4495-9C1E-50DF8A571152}"
        DTS:ObjectName="CM_Guidewire_PG_Source">
      <DTS:ObjectData>
        <DTS:ConnectionManager>
          <DTS:Property DTS:Name="ConnectionString">Server=gw-pg-source.internal;Port=5432;Database=guidewire_policycenter;User Id=etl_reader;Password=[SECURED_BY_PARAMETER];</DTS:Property>
          <DTS:Property DTS:Name="Provider">Npgsql PostgreSQL Provider</DTS:Property>
          <DTS:Property DTS:Name="Description">Source: Guidewire PolicyCenter PostgreSQL replica (read-only)</DTS:Property>
        </DTS:ConnectionManager>
      </DTS:ObjectData>
    </DTS:ConnectionManager>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[CM_DW_PG_Target]"
        DTS:CreationName="ADO.NET:Npgsql"
        DTS:DTSID="{687226D2-4BD4-4707-A18E-CDBC9918635C}"
        DTS:ObjectName="CM_DW_PG_Target">
      <DTS:ObjectData>
        <DTS:ConnectionManager>
          <DTS:Property DTS:Name="ConnectionString">Server=dw-pg-target.internal;Port=5432;Database=insurance_dw;User Id=etl_writer;Password=[SECURED_BY_PARAMETER];</DTS:Property>
          <DTS:Property DTS:Name="Provider">Npgsql PostgreSQL Provider</DTS:Property>
          <DTS:Property DTS:Name="Description">Target: Insurance Data Warehouse - stg / rpt schemas (PostgreSQL)</DTS:Property>
        </DTS:ConnectionManager>
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\SQL_LogStart" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{031A2927-A6ED-488E-A5D2-78EFB7385AAB}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="SQL - Log Package Start">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
            SQLTask:Connection="CM_DW_PG_Target"
            SQLTask:SqlStatementSource="INSERT INTO etl.etl_audit_log (package_name, task_name, start_time, status) VALUES (&apos;Extract_Producer&apos;, &apos;Data Flow&apos;, now(), &apos;RUNNING&apos;)" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\DFT_Main" DTS:CreationName="Microsoft.Pipeline" DTS:DTSID="{15B8FE52-FD7C-4323-804E-EF4AE342A66F}" DTS:ExecutableType="Microsoft.Pipeline" DTS:ObjectName="DFT - Extract, Cleanse, Validate, Load producer">
      <DTS:ObjectData>
    <pipeline version="1">
      <components>
      <component name="SRC - producer (PostgreSQL)" componentClassID="Microsoft.ADO.NET.PGSource" description="Extracts rows from public.producer on CM_Guidewire_PG_Source">
        <properties>
          <property name="SqlCommand">SELECT producer_id, producer_code, producer_name, commission_rate, producer_type, state_code, producer_status, created_date FROM public.producer</property>
          <property name="ConnectionManager">CM_Guidewire_PG_Source</property>
        </properties>
        <outputs>
          <output name="OLE DB Source Output" />
          <output name="OLE DB Source Error Output" />
        </outputs>
      </component>
      <component name="DER - Data Cleansing" componentClassID="Microsoft.DerivedColumn" description="Trims whitespace, standardizes casing/codes, normalizes nulls">
        <properties>
          <property name="Expressions">TRIM(producer_name) -&gt; producer_name; UPPER(TRIM(state_code)) -&gt; state_code</property>
        </properties>
        <inputs>
          <input name="OLE DB Source Output" />
        </inputs>
        <outputs>
          <output name="Cleansing Output" />
        </outputs>
      </component>
      <component name="DER - Derived / Calculated Columns" componentClassID="Microsoft.DerivedColumn" description="Adds ETL metadata columns and business-calculated fields">
        <properties>
          <property name="Expressions">GETDATE() -&gt; etl_load_date</property>
        </properties>
        <inputs>
          <input name="Cleansing Output" />
        </inputs>
        <outputs>
          <output name="Derived Column Output" />
        </outputs>
      </component>
      <component name="CSPL - Business Rule Validation" componentClassID="Microsoft.ConditionalSplit" description="Routes rows failing business rules to error output. Rules: commission_rate &gt;= 0.00 AND commission_rate &lt;= 100.00 | producer_type IN (&apos;AGENCY&apos;,&apos;BROKER&apos;,&apos;AGENT&apos;,&apos;INDIVIDUAL&apos;) | created_date &lt;= GETDATE()">
        <properties>
          <property name="ValidOutputName">Valid Rows</property>
          <property name="InvalidOutputName">Invalid Rows (-&gt; Error Path)</property>
          <property name="Conditions">commission_rate &gt;= 0.00 AND commission_rate &lt;= 100.00 | producer_type IN ('AGENCY','BROKER','AGENT','INDIVIDUAL') | created_date &lt;= GETDATE()</property>
        </properties>
        <inputs>
          <input name="Derived Column Output" />
        </inputs>
        <outputs>
          <output name="Valid Rows" />
          <output name="Invalid Rows (-> Error Path)" />
        </outputs>
      </component>
      <component name="UN - Union All Error Rows" componentClassID="Microsoft.UnionAll" description="Combines all error/no-match/invalid outputs into a single error stream">
        <properties>

        </properties>
        <inputs>
          <input name="Lookup No Match Output (-> Error Path)" />
          <input name="Invalid Rows (-> Error Path)" />
          <input name="OLE DB Source Error Output" />
        </inputs>
        <outputs>
          <output name="Unified Error Output" />
        </outputs>
      </component>
      <component name="DST - Error Log (stg.error_quarantine)" componentClassID="Microsoft.OLEDBDestination" description="Writes rejected/invalid rows to the error-quarantine table for review">
        <properties>
          <property name="OpenRowset">stg.error_quarantine</property>
          <property name="ConnectionManager">CM_DW_PG_Target</property>
        </properties>
        <inputs>
          <input name="Unified Error Output" />
        </inputs>
      </component>
      <component name="DST - Load producer (PostgreSQL DW)" componentClassID="Microsoft.OLEDBDestination" description="Loads validated/cleansed rows into stg.producer (upsert via staging + MERGE in post-SQL)">
        <properties>
          <property name="OpenRowset">stg.producer</property>
          <property name="ConnectionManager">CM_DW_PG_Target</property>
          <property name="FastLoad">true</property>
          <property name="MaximumInsertCommitSize">10000</property>
        </properties>
        <inputs>
          <input name="Valid Rows" />
        </inputs>
      </component>
      </components>
    </pipeline>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\SQL_LogEnd" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{7B80AFD1-2D84-4BCF-BDFA-2112DCCA68ED}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="SQL - Log Package End / Row Counts">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
            SQLTask:Connection="CM_DW_PG_Target"
            SQLTask:SqlStatementSource="UPDATE etl.etl_audit_log SET end_time = now(), status = &apos;COMPLETED&apos;, rows_read = ?, rows_inserted = ?, rows_rejected = ? WHERE package_name = &apos;Extract_Producer&apos; AND status = &apos;RUNNING&apos;" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[SQL_LogStartToDFT_Main]"
        DTS:From="Package\SQL_LogStart" DTS:To="Package\DFT_Main" DTS:Value="3" DTS:DTSID="{48746181-8332-4670-9A35-1793B355A9E9}" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[DFT_MainToSQL_LogEnd]"
        DTS:From="Package\DFT_Main" DTS:To="Package\SQL_LogEnd" DTS:Value="1" DTS:DTSID="{3A4EA97B-28B9-4344-AF5E-C73B66204F97}" />
  </DTS:PrecedenceConstraints>
  <DTS:EventHandlers>
    <DTS:EventHandler DTS:EventName="OnError" DTS:DTSID="{2F8FF7B0-2A1D-4D8C-9C83-64E6F8E7C73E}" DTS:ObjectName="OnError">
      <DTS:Executables>
    <DTS:Executable DTS:refId="Package\EH_LogError" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{A3923964-C2F6-4564-9A1F-653EB561365A}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="SQL - Log Error to ETL_ERROR_LOG">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
            SQLTask:Connection="CM_DW_PG_Target"
            SQLTask:SqlStatementSource="INSERT INTO etl.etl_error_log (package_name, source_object, error_code, error_description, error_time) VALUES (&apos;Extract_Producer&apos;, ?, ?, ?, now())" />
      </DTS:ObjectData>
    </DTS:Executable>

      </DTS:Executables>
    </DTS:EventHandler>
  </DTS:EventHandlers>
</DTS:Executable>
