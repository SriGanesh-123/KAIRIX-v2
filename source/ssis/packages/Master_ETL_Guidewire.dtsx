    DTS:VersionMajor="1" DTS:VersionMinor="0" DTS:VersionBuild="1"
    DTS:VersionGUID="{626CDECA-7506-4AEF-AB7D-894A975BF613}"
    DTS:Description="Master orchestration package for Source System 3 (Guidewire PolicyCenter PostgreSQL). Executes all child ETL packages in FK-dependency order: Account/Producer -&gt; Policy -&gt; Job/Claims -&gt; Policy_Period -&gt; Location/Coverage/Premium -&gt; KPI Aggregates. Provides audit logging and centralized error handling."
    DTS:LoggingMode="UseParentSetting">
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[CM_DW_PG_Target]"
        DTS:CreationName="ADO.NET:Npgsql"
        DTS:DTSID="{248FFA76-0389-4A8D-AE39-0CA6BBE7AA83}"
        DTS:ObjectName="CM_DW_PG_Target">
      <DTS:ObjectData>
        <DTS:ConnectionManager>
          <DTS:Property DTS:Name="ConnectionString">Server=dw-pg-target.internal;Port=5432;Database=insurance_dw;User Id=etl_writer;Password=[SECURED_BY_PARAMETER];</DTS:Property>
          <DTS:Property DTS:Name="Provider">Npgsql PostgreSQL Provider</DTS:Property>
        </DTS:ConnectionManager>
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Executables>
