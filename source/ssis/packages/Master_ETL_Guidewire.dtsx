      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="CM_DW_PG_Target" SQLTask:SqlStatementSource="INSERT INTO etl.etl_audit_log (package_name, task_name, start_time, status) VALUES (&apos;Master_ETL_Guidewire&apos;, &apos;Full Load&apos;, now(), &apos;RUNNING&apos;)" />
