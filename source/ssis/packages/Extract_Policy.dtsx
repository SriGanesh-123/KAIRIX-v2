<?xml version="1.0"?>
<DTS:Executable
    xmlns:DTS="www.microsoft.com/SqlServer/Dts"
    xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
    DTS:ExecutableType="Microsoft.Package"
    DTS:CreationName="Microsoft.Package"
    DTS:DTSID="{4EC70694-CDC4-4631-80BF-18DEE7B21121}"
    DTS:ObjectName="Extract_Policy"
    DTS:PackageType="5"
    DTS:VersionMajor="1" DTS:VersionMinor="0" DTS:VersionBuild="1"
    DTS:VersionGUID="{991D0A86-93FD-4C8A-A1F2-91ED4989ACC6}"
    DTS:Description="Extracts POLICY, validates FK to ACCOUNT and PRODUCER (BR-01), cleanses and loads."
    DTS:LoggingMode="UseParentSetting">
  <DTS:Variables>
    <DTS:Variable DTS:Name="RowsRead"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable>
    <DTS:Variable DTS:Name="RowsInserted"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable>
    <DTS:Variable DTS:Name="RowsRejected"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable>
    <DTS:Variable DTS:Name="PackageName"><DTS:VariableValue DTS:DataType="8">Extract_Policy</DTS:VariableValue></DTS:Variable>
    <DTS:Variable DTS:Name="StartTime"><DTS:VariableValue DTS:DataType="7">1900-01-01T00:00:00</DTS:VariableValue></DTS:Variable>
  </DTS:Variables>
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[CM_Guidewire_PG_Source]"
        DTS:CreationName="ADO.NET:Npgsql"
        DTS:DTSID="{9115364D-372C-4495-9C1E-50DF8A571152}"
        DTS:ObjectName="CM_Guidewire_PG_Source">
      <DTS:ObjectData>
        <DTS:ConnectionManager>
          <DTS:Property DTS:Name="ConnectionString">Server=gw-pg-source.internal;Port=5432;Database=guidewire_policycenter;User Id=etl_reader;Password=[SECURED_BY_PARAMETER];</DTS:Property>
          <DTS:Property DTS:Name="Provider">Npgsql PostgreSQL Provider</DTS:Property>
          <DTS:Property DTS:Name="Description">Source: Guidewire PolicyCenter PostgreSQL replica (read-only)</DTS:Property>
        </DTS:ConnectionManager>
      </DTS:ObjectData>
    </DTS:ConnectionManager>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[CM_DW_PG_Target]"
        DTS:CreationName="ADO.NET:Npgsql"
        DTS:DTSID="{687226D2-4BD4-4707-A18E-CDBC9918635C}"
        DTS:ObjectName="CM_DW_PG_Target">
      <DTS:ObjectData>
        <DTS:ConnectionManager>
          <DTS:Property DTS:Name="ConnectionString">Server=dw-pg-target.internal;Port=5432;Database=insurance_dw;User Id=etl_writer;Password=[SECURED_BY_PARAMETER];</DTS:Property>
          <DTS:Property DTS:Name="Provider">Npgsql PostgreSQL Provider</DTS:Property>
          <DTS:Property DTS:Name="Description">Target: Insurance Data Warehouse - stg / rpt schemas (PostgreSQL)</DTS:Property>
        </DTS:ConnectionManager>
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\SQL_LogStart" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{30C846BB-1546-43D7-8B26-E31E74379975}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="SQL - Log Package Start">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
            SQLTask:Connection="CM_DW_PG_Target"
            SQLTask:SqlStatementSource="INSERT INTO etl.etl_audit_log (package_name, task_name, start_time, status) VALUES (&apos;Extract_Policy&apos;, &apos;Data Flow&apos;, now(), &apos;RUNNING&apos;)" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\DFT_Main" DTS:CreationName="Microsoft.Pipeline" DTS:DTSID="{9101BEE4-4A7E-423C-B078-A7B4B528DD90}" DTS:ExecutableType="Microsoft.Pipeline" DTS:ObjectName="DFT - Extract, Cleanse, Validate, Load policy">
      <DTS:ObjectData>
    <pipeline version="1">
      <components>
      <component name="SRC - policy (PostgreSQL)" componentClassID="Microsoft.ADO.NET.PGSource" description="Extracts rows from public.policy on CM_Guidewire_PG_Source">
        <properties>
          <property name="SqlCommand">SELECT policy_id, account_id, producer_id, policy_number, product_code, policy_status, effective_date, expiration_date, cancellation_date, cancellation_reason, updated_timestamp FROM public.policy</property>
          <property name="ConnectionManager">CM_Guidewire_PG_Source</property>
        </properties>
        <outputs>
          <output name="OLE DB Source Output" />
          <output name="OLE DB Source Error Output" />
        </outputs>
      </component>
      <component name="LKP - Validate Account (account_id)" componentClassID="Microsoft.Lookup" description="Validates account_id exists in Account (referential integrity / BR-01, BR-05)">
        <properties>
          <property name="SqlCommandParam">SELECT account_id FROM stg.account</property>
          <property name="JoinColumn">account_id</property>
          <property name="NoMatchBehavior">RedirectRowsToNoMatchOutput</property>
          <property name="CacheMode">Full</property>
        </properties>
        <inputs>
          <input name="OLE DB Source Output" />
        </inputs>
        <outputs>
          <output name="Lookup Match Output" />
          <output name="Lookup No Match Output (-> Error Path)" />
        </outputs>
      </component>
      <component name="LKP - Validate Producer (producer_id)" componentClassID="Microsoft.Lookup" description="Validates producer_id exists in Producer (referential integrity / BR-01, BR-05)">
        <properties>
          <property name="SqlCommandParam">SELECT producer_id FROM stg.producer</property>
          <property name="JoinColumn">producer_id</property>
          <property name="NoMatchBehavior">RedirectRowsToNoMatchOutput</property>
          <property name="CacheMode">Full</property>
        </properties>
        <inputs>
          <input name="Lookup Match Output" />
        </inputs>
        <outputs>
          <output name="Lookup Match Output" />
          <output name="Lookup No Match Output (-> Error Path)" />
        </outputs>
      </component>
      <component name="DER - Data Cleansing" componentClassID="Microsoft.DerivedColumn" description="Trims whitespace, standardizes casing/codes, normalizes nulls">
        <properties>
          <property name="Expressions">TRIM(policy_number) -&gt; policy_number; UPPER(product_code) -&gt; product_code</property>
        </properties>
        <inputs>
          <input name="Lookup Match Output" />
        </inputs>
        <outputs>
          <output name="Cleansing Output" />
        </outputs>
      </component>
      <component name="DER - Derived / Calculated Columns" componentClassID="Microsoft.DerivedColumn" description="Adds ETL metadata columns and business-calculated fields">
        <properties>
          <property name="Expressions">GETDATE() -&gt; etl_load_date</property>
        </properties>
        <inputs>
          <input name="Cleansing Output" />
        </inputs>
        <outputs>
          <output name="Derived Column Output" />
        </outputs>
      </component>
      <component name="CSPL - Business Rule Validation" componentClassID="Microsoft.ConditionalSplit" description="Routes rows failing business rules to error output. Rules: expiration_date &gt; effective_date | policy_status IN (&apos;ACTIVE&apos;,&apos;INACTIVE&apos;,&apos;LAPSED&apos;,&apos;CANCELLED&apos;) | (cancellation_date IS NULL) OR (cancellation_date &gt; effective_date AND cancellation_date &lt; expiration_date)">
        <properties>
          <property name="ValidOutputName">Valid Rows</property>
          <property name="InvalidOutputName">Invalid Rows (-&gt; Error Path)</property>
          <property name="Conditions">expiration_date &gt; effective_date | policy_status IN ('ACTIVE','INACTIVE','LAPSED','CANCELLED') | (cancellation_date IS NULL) OR (cancellation_date &gt; effective_date AND cancellation_date &lt; expiration_date)</property>
        </properties>
        <inputs>
          <input name="Derived Column Output" />
        </inputs>
        <outputs>
          <output name="Valid Rows" />
          <output name="Invalid Rows (-> Error Path)" />
        </outputs>
      </component>
      <component name="UN - Union All Error Rows" componentClassID="Microsoft.UnionAll" description="Combines all error/no-match/invalid outputs into a single error stream">
        <properties>

        </properties>
        <inputs>
          <input name="Lookup No Match Output (-> Error Path)" />
          <input name="Invalid Rows (-> Error Path)" />
          <input name="OLE DB Source Error Output" />
        </inputs>
        <outputs>
          <output name="Unified Error Output" />
        </outputs>
      </component>
      <component name="DST - Error Log (stg.error_quarantine)" componentClassID="Microsoft.OLEDBDestination" description="Writes rejected/invalid rows to the error-quarantine table for review">
        <properties>
          <property name="OpenRowset">stg.error_quarantine</property>
          <property name="ConnectionManager">CM_DW_PG_Target</property>
        </properties>
        <inputs>
          <input name="Unified Error Output" />
        </inputs>
      </component>
      <component name="DST - Load policy (PostgreSQL DW)" componentClassID="Microsoft.OLEDBDestination" description="Loads validated/cleansed rows into stg.policy (upsert via staging + MERGE in post-SQL)">
        <properties>
          <property name="OpenRowset">stg.policy</property>
          <property name="ConnectionManager">CM_DW_PG_Target</property>
          <property name="FastLoad">true</property>
          <property name="MaximumInsertCommitSize">10000</property>
        </properties>
        <inputs>
          <input name="Valid Rows" />
        </inputs>
      </component>
      </components>
    </pipeline>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\SQL_LogEnd" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{DC62FAB3-1717-4064-93B0-1C106A5EBF80}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="SQL - Log Package End / Row Counts">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
            SQLTask:Connection="CM_DW_PG_Target"
            SQLTask:SqlStatementSource="UPDATE etl.etl_audit_log SET end_time = now(), status = &apos;COMPLETED&apos;, rows_read = ?, rows_inserted = ?, rows_rejected = ? WHERE package_name = &apos;Extract_Policy&apos; AND status = &apos;RUNNING&apos;" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[SQL_LogStartToDFT_Main]"
        DTS:From="Package\SQL_LogStart" DTS:To="Package\DFT_Main" DTS:Value="3" DTS:DTSID="{6F1C614D-7B4B-4F5E-855B-73FCAF369B01}" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[DFT_MainToSQL_LogEnd]"
        DTS:From="Package\DFT_Main" DTS:To="Package\SQL_LogEnd" DTS:Value="1" DTS:DTSID="{886C148F-CAB9-418C-8CB7-B6DCFB557765}" />
  </DTS:PrecedenceConstraints>
  <DTS:EventHandlers>
    <DTS:EventHandler DTS:EventName="OnError" DTS:DTSID="{49464C8C-6A0E-463F-A975-74E0BF4C2AA8}" DTS:ObjectName="OnError">
      <DTS:Executables>
    <DTS:Executable DTS:refId="Package\EH_LogError" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{E7763469-56CE-4FA5-819E-2370038090D7}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="SQL - Log Error to ETL_ERROR_LOG">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
            SQLTask:Connection="CM_DW_PG_Target"
            SQLTask:SqlStatementSource="INSERT INTO etl.etl_error_log (package_name, source_object, error_code, error_description, error_time) VALUES (&apos;Extract_Policy&apos;, ?, ?, ?, now())" />
      </DTS:ObjectData>
    </DTS:Executable>

      </DTS:Executables>
    </DTS:EventHandler>
  </DTS:EventHandlers>
</DTS:Executable>
